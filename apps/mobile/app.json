{
  "expo": {
    "name": "UE-MCP Studio",
    "slug": "ue-mcp-studio",
    "scheme": "uemcpstudio",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0c0c0b",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.uemcp.studio.remote",
      "infoPlist": {
        "NSCameraUsageDescription": "UE-MCP Studio scans the pairing code your computer shows.",
        "NSFaceIDUsageDescription": "UE-MCP Studio uses Face ID to unlock with the PIN you set on your computer.",
        "NSPhotoLibraryUsageDescription": "UE-MCP Studio attaches the images you pick to a message, and reads a pairing code from a saved picture."
      },
      "associatedDomains": [
        "applinks:remote.ue-mcp.com"
      ]
    },
    "android": {
      "package": "com.uemcp.studio.remote",
      "versionCode": 6,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#0c0c0b"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.VIBRATE"
      ],
      "predictiveBackGestureEnabled": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "remote.ue-mcp.com",
              "pathPrefix": "/pair"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "UE-MCP Studio scans the pairing code your computer shows.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0c0c0b",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#0c0c0b",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "UE-MCP Studio uses Face ID to unlock with the PIN you set on your computer."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "UE-MCP Studio attaches the images you pick to a message, and reads a pairing code from a saved picture.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "text/*",
            "image/*"
          ],
          "androidMultiIntentFilters": [
            "image/*"
          ],
          "disableIOS": true
        }
      ],
      "expo-quick-actions",
      "./plugins/with-release-signing"
    ]
  }
}
