{
  "name": "ue-mcp-studio",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @ue-mcp-studio/shared && npm run build -w @ue-mcp-studio/client-web && npm run build -w @ue-mcp-studio/agent",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "dev": "npm run dev -w @ue-mcp-studio/client-web",
    "keys:dev": "node scripts/dev-keys.mjs",
    "install:dev": "node scripts/install-dev.mjs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.24.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  },
  "version": "0.1.0-beta.29",
  "studioPlugin": {
    "min": "0.1.0-beta.9"
  }
}
