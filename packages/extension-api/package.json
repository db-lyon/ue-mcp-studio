{
  "name": "@ue-mcp-studio/extension-api",
  "version": "0.1.0",
  "description": "Types and constants for UE-MCP Studio extensions: UI slots, their contexts and the card transcript entry.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/db-lyon/ue-mcp-studio.git",
    "directory": "packages/extension-api"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  }
}
